# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 mambaorg/micromamba:1.5.8

WORKDIR /app
COPY mesoscale/environment-sharppy-api.yml /tmp/environment-sharppy-api.yml
RUN micromamba create -y -n btv-sharppy-api -f /tmp/environment-sharppy-api.yml \
    && micromamba clean --all --yes

COPY mesoscale/sharppy_adapter.py mesoscale/sharppy_service.py mesoscale/bufkit_feed.py /app/mesoscale/
RUN mkdir -p /tmp/bufkit-cache && chmod 777 /tmp/bufkit-cache

ENV BUFKIT_CACHE_DIR=/tmp/bufkit-cache
ENV BUFKIT_CACHE_TTL_SECONDS=300
EXPOSE 8000

CMD ["micromamba", "run", "-n", "btv-sharppy-api", "uvicorn", "mesoscale.sharppy_service:app", "--host", "0.0.0.0", "--port", "8000"]
