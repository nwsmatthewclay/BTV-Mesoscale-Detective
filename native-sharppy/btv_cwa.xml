<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<sourcelist>
  <!-- Cycle-aware feeds backed by the versioned BTV BUFKIT archive Worker. -->
  <datasource name="BTV CWA RRFS" ensemble="false" observed="false">
    <outlet name="BTV Archive" url="https://BTV_WORKER_HOST/bufkit/RRFS/{date}{cycle}_{srcid}.buf" format="bufkit">
      <time first="0" range="84" delta="1" offset="0" delay="2" cycle="1" archive="192" start="-" end="-"/>
      <points csv="btv_cwa.csv"/>
    </outlet>
  </datasource>
  <datasource name="BTV CWA GFS" ensemble="false" observed="false">
    <outlet name="BTV Archive" url="https://BTV_WORKER_HOST/bufkit/GFS/{date}{cycle}_{srcid}.buf" format="bufkit">
      <time first="0" range="180" delta="1" offset="0" delay="5" cycle="6" archive="192" start="-" end="-"/>
      <points csv="btv_cwa.csv"/>
    </outlet>
  </datasource>
  <datasource name="BTV CWA RAP" ensemble="false" observed="false">
    <outlet name="BTV Archive" url="https://BTV_WORKER_HOST/bufkit/RAP/{date}{cycle}_{srcid}.buf" format="bufkit">
      <time first="0" range="21" delta="1" offset="0" delay="2" cycle="1" archive="144" start="-" end="-"/>
      <points csv="btv_cwa.csv"/>
    </outlet>
  </datasource>
  <datasource name="BTV CWA HRRR" ensemble="false" observed="false">
    <outlet name="BTV Archive" url="https://BTV_WORKER_HOST/bufkit/HRRR/{date}{cycle}_{srcid}.buf" format="bufkit">
      <time first="0" range="48" delta="1" offset="0" cycle="1" archive="144" start="-" end="-"/>
      <points csv="btv_cwa.csv"/>
    </outlet>
  </datasource>
</sourcelist>
